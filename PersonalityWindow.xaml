<Window x:Class="AganBrowser.PersonalityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ağan'ın Kişiliği" Height="500" Width="400"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Ağan'ın karakterini özelleştir:" FontWeight="Bold" Margin="0,0,0,10" Grid.Row="0" Foreground="{DynamicResource ForegroundBrush}"/>
        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="TraitsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsActive, Mode=TwoWay}" Margin="0,6" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Button Content="Kaydet ve Kapat" Click="Save_Click" Grid.Row="2" Margin="0,10,0,0" Padding="10,5" HorizontalAlignment="Right"/>
    </Grid>
</Window>
