<Window x:Class="AganBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ağan" Height="820" Width="1440"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{DynamicResource ForegroundBrush}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedItemBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="TabIcon" Width="16" Height="16" Margin="0,0,6,0" Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <Button Content="✕" Width="20" Height="20" Padding="0" Margin="0"
                                    FontSize="11"
                                    Click="TabClose_Click"
                                    Tag="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{DynamicResource BarBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,1,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="6">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="◀" Width="38" Click="Back_Click" ToolTip="Geri"/>
                    <Button Content="▶" Width="38" Click="Forward_Click" ToolTip="İleri"/>
                    <Button Content="⟳" Width="38" Click="Refresh_Click" ToolTip="Yenile"/>
                    <Button Content="⬍" Width="38" Click="VerticalTabs_Click" ToolTip="Dikey Sekmeler"/>
                    <Button Content="+ Sekme" Click="NewTab_Click" ToolTip="Yeni Sekme"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AdBlockToggle" Content="Reklam: AÇIK" Click="AdBlock_Click" ToolTip="Reklam Engelleyici"/>
                    <Button Content="Şifreler" Click="Passwords_Click"/>
                    <Button Content="Uzantılar" Click="Extensions_Click"/>
                    <Button Content="Tema ▾" Click="ThemeMenu_Click" ToolTip="Tema Ayarları"/>
                    <Button Content="Sol Panel" Click="ToggleLeftPanel_Click" ToolTip="Sol Paneli Aç/Kapat"/>
                    <Button Content="Sağ Panel" Click="ToggleRightPanel_Click" ToolTip="Sağ Paneli Aç/Kapat"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SecurityIcon" Text="🔒" VerticalAlignment="Center" Margin="4,0" FontSize="16"/>
                    <TextBox x:Name="AddressBar" Height="30" VerticalContentAlignment="Center" KeyDown="AddressBar_KeyDown" Width="800"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="LeftSidebar" Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <Button Content="🛠️ Kevora Tools" Click="OpenKevoraTools_Click" Margin="0,4,0,8" FontWeight="Bold"/>
                        
                        <TextBlock Text="Uzantılar" FontWeight="Bold" Margin="2,4" FontSize="14"/>
                        <ListBox x:Name="ExtensionsList" Height="120"/>
                        <Button Content="Uzantıları Yönet" Click="Extensions_Click" Margin="0,4"/>

                        <TextBlock Text="Kaydet" FontWeight="Bold" Margin="2,12,2,4" FontSize="14"/>
                        <Button Content="PDF Kaydet" Click="SavePdf_Click"/>
                        <Button Content="HTML Kaydet" Click="SaveHtml_Click"/>

                        <TextBlock Text="AI Araçları" FontWeight="Bold" Margin="2,12,2,4" FontSize="14"/>
                        <Button Content="Metin Üret" Click="TextGenerate_Click"/>
                        <Button Content="Çeviri Yap" Click="Translate_Click"/>
                        <Button Content="Görsel Ara" Click="ImageSearch_Click"/>
                        <Button Content="Görsel Dönüştür" Click="ImageConvert_Click"/>

                        <TextBlock Text="Şifre" FontWeight="Bold" Margin="2,12,2,4" FontSize="14"/>
                        <Button Content="Otomatik Doldur" Click="AutoFillPassword_Click"/>
                        
                        <TextBlock Text="Kısayollar" FontWeight="Bold" Margin="2,12,2,4" FontSize="14"/>
                        <ListBox x:Name="ShortcutsList" Height="120" MouseDoubleClick="ShortcutsList_DoubleClick"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ Ekle" Click="AddShortcut_Click"/>
                            <Button Content="Sil" Click="DeleteShortcut_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid x:Name="TabContainer" Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" x:Name="TabTopRow"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0" x:Name="TabLeftCol"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TabControl x:Name="TabStrip" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                            Background="{DynamicResource BarBrush}" BorderThickness="0"
                            SelectionChanged="TabStrip_SelectionChanged">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <TabPanel IsItemsHost="True" Background="{DynamicResource BarBrush}"/>
                        </ControlTemplate>
                    </TabControl.Template>
                </TabControl>

                <Grid x:Name="WebViewHost" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                      Background="{DynamicResource BackgroundBrush}"/>
            </Grid>

            <Border x:Name="RightPanel" Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        
                        <Border Background="{DynamicResource BarBrush}" Padding="8" Margin="0,0,0,8" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="OllamaDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="OllamaStatusText" Text="Ollama: kontrol ediliyor..." FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Model" FontWeight="Bold" Margin="0,8,0,2"/>
                        <ComboBox x:Name="ModelComboBox" Margin="0,0,0,8" SelectionChanged="ModelComboBox_SelectionChanged"/>

                        <TextBlock Text="İndirmeler" FontWeight="Bold" Margin="0,8,0,2"/>
                        <ListBox x:Name="DownloadsMiniList" MaxHeight="160" Margin="0,0,0,4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Height="6" Maximum="100" Value="{Binding Progress}" Margin="0,2"/>
                                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="Tüm İndirmeleri Gör" Click="Downloads_Click" Margin="0,0,0,8"/>

                        <Button Content="🔍 Sayfayı İncele (DevTools)" Click="OpenDevTools_Click" FontWeight="Bold" Margin="0,8,0,8"/>

                        <Button Content="🤖 Ağan ile Konuş" Click="OpenAganMini_Click" FontWeight="Bold" Margin="0,8,0,8"
                                Background="{DynamicResource AccentBrush}" Foreground="White"/>

                        <TextBlock Text="Sayfa Bilgisi" FontWeight="Bold" Margin="0,8,0,2"/>
                        <TextBlock x:Name="PageInfoText" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ContextSizeText" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,8"/>

                        <TextBlock Text="Yer İmleri" FontWeight="Bold" Margin="0,8,0,2"/>
                        <ListBox x:Name="BookmarksList" MaxHeight="160" Margin="0,0,0,4" MouseDoubleClick="BookmarksList_DoubleClick"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="⭐ Bu Sayfayı Ekle" Click="AddBookmark_Click" Margin="0,0,4,0"/>
                            <Button Content="Sil" Click="DeleteBookmark_Click"/>
                        </StackPanel>

                        <TextBlock Text="Geçmiş" FontWeight="Bold" Margin="0,8,0,2"/>
                        <ListBox x:Name="HistoryList" MaxHeight="140" Margin="0,0,0,4" MouseDoubleClick="HistoryList_DoubleClick"/>
                        <Button Content="Geçmişi Temizle" Click="ClearHistory_Click" Margin="0,0,0,8"/>

                        <TextBlock x:Name="TabsMiniHeader" Text="Sekmeler" FontWeight="Bold" Margin="0,8,0,2"/>
                        <ListBox x:Name="TabsMiniList" MaxHeight="160" Margin="0,0,0,8" SelectionChanged="TabsMiniList_SelectionChanged"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="6,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Hazır" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                <TextBlock x:Name="ZoomText" Grid.Column="1" Text="100%" VerticalAlignment="Center" Margin="10,0" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                <TextBlock x:Name="AdBlockStatus" Grid.Column="2" Text="Engellenen: 0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>