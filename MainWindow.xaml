            {
                DialogHelper.Info("Oku Sonra", "Aktif sekme yok.");
                return;
            }

            string title = string.IsNullOrWhiteSpace(_activeWebView.CoreWebView2.DocumentTitle) 
                ? "Başlıksız" 
                : _activeWebView.CoreWebView2.DocumentTitle;
