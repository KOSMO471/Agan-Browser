            {
                DialogHelper.Info("Oku Sonra", "Bu sayfa kaydedilemez.");
                return;
            }

            string json = await _activeWebView.CoreWebView2.ExecuteScriptAsync("document.body ? document.body.innerHTML : ''");
            string bodyHtml = JsonSerializer.Deserialize<string>(json) ?? "";
            
            _readLaterService.Save(title, url, bodyHtml);
            DialogHelper.Info("Oku Sonra", $"'{title}' kaydedildi.\nYeni sekmede listeden açabilirsiniz.");
        }

